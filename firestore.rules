rules_version = '2';
// Sicherheitsregeln des Vereinsportals. Grundsatz: Öffentliches ist für alle lesbar, alles andere nur für angemeldete,
// aktive Benutzer – und geschrieben wird nur mit dem passenden Recht der Rolle (Rechte-Matrix in meta/verein.rechte).
// Trainer dürfen zusätzlich die Daten ihrer eigenen Mannschaften pflegen.
service cloud.firestore {
  match /databases/{db}/documents {
    function angemeldet() { return request.auth != null; }
    function profilPfad() { return /databases/$(db)/documents/benutzer/$(request.auth.uid); }
    function ich() { return get(profilPfad()).data; }
    function aktiv() { return angemeldet() && exists(profilPfad()) && ich().aktiv == true; }
    function rolle() { return ich().rolle; }
    function eingerichtet() { return exists(/databases/$(db)/documents/meta/verein); }
    function verein() { return get(/databases/$(db)/documents/meta/verein).data; }
    // Zwei-Faktor-Pflicht für Administratoren (meta/verein.zweiFaktorPflicht): Sitzung muss mit zweitem Faktor angemeldet sein
    function zweiterFaktorOk() {
      return !eingerichtet() || verein().get('zweiFaktorPflicht', false) != true
        || request.auth.token.firebase.get('sign_in_second_factor', null) != null;
    }
    function darf(recht) {
      return aktiv() && ((rolle() == 'admin' && zweiterFaktorOk())
        || (eingerichtet() && rolle() != 'admin' && recht in verein().rechte[rolle()]));
    }
    // Testbetrieb: Inhalte für Gäste erst nach Veröffentlichung (meta/verein.veroeffentlicht), Angemeldete sehen immer alles
    function sichtbar() { return aktiv() || (eingerichtet() && verein().get('veroeffentlicht', false) == true); }
    function trainerVon(mannschaftId) { return aktiv() && rolle() == 'trainer' && mannschaftId in ich().mannschaftIds; }
    function nurFelder(felder) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(felder); }
    function team() { return request.resource != null ? request.resource.data.mannschaftId : resource.data.mannschaftId; }

    // ---- Vereinsdaten ----
    match /meta/verein {
      allow read: if true;
      allow create: if aktiv() && rolle() == 'admin' && !eingerichtet();
      allow update: if (darf('verein.verwalten') || darf('rechte.verwalten'))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rechte']) || darf('rechte.verwalten'))
        // die Zwei-Faktor-Pflicht schalten nur Administratoren
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['zweiFaktorPflicht']) || (rolle() == 'admin' && zweiterFaktorOk()));
    }
    match /meta/geburtstage { allow read: if sichtbar(); allow write: if darf('mitglieder.verwalten'); }

    // ---- Benutzer ----
    match /benutzer/{uid} {
      // Eigenes Profil immer; die ganze Liste (E-Mail, Telefon) nur für die Verwaltung
      allow read: if (angemeldet() && (request.auth.uid == uid || resource.data.id == request.auth.uid))
        || darf('benutzer.verwalten') || darf('mannschaften.verwalten') || darf('email.senden') || darf('verein.verwalten');
      // Ersteinrichtung: das erste Konto legt sich selbst als Admin an, solange die Datenbank leer ist
      allow create: if (angemeldet() && request.auth.uid == uid && !eingerichtet() && request.resource.data.rolle == 'admin'
          && request.auth.token.email.lower() in ['emmoke@outlook.de', 'sewar.khalil@outlook.de'])
        // Selbstregistrierung: nur als gesperrtes Mitglied ohne Mannschaften, mit der eigenen Login-E-Mail
        // (fehlt das Feld noch, gilt wie im Portal: eingeschaltet)
        || (angemeldet() && request.auth.uid == uid && eingerichtet() && verein().get('registrierungAktiv', true) == true
          && request.resource.data.rolle == 'mitglied' && request.resource.data.aktiv == false
          && request.resource.data.mannschaftIds.size() == 0 && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.keys().hasOnly(['id', 'vorname', 'nachname', 'email', 'rolle', 'mannschaftIds', 'passwortHash', 'aktiv', 'registriertAm', 'einwilligung'])
          && request.resource.data.vorname.size() <= 60 && request.resource.data.nachname.size() <= 60)
        || darf('benutzer.verwalten');
      allow update: if darf('benutzer.verwalten')
        || (aktiv() && request.auth.uid == uid && nurFelder(['vorname', 'nachname', 'telefon', 'letzteAnmeldung']));
      allow delete: if darf('benutzer.verwalten') && request.auth.uid != uid;
    }

    // ---- Öffentlich lesbar ----
    match /mannschaften/{id} { allow read: if sichtbar(); allow write: if darf('mannschaften.verwalten'); }
    match /spieler/{id} { allow read: if sichtbar(); allow write: if darf('mannschaften.verwalten') || trainerVon(team()); }
    match /spiele/{id} {
      allow read: if sichtbar();
      allow write: if darf('spiele.verwalten') || trainerVon(team());
      // Mitglieder geben ihre Zu-/Absage ab
      allow update: if aktiv() && nurFelder(['zusagen']);
    }
    match /tabellen/{id} { allow read: if sichtbar(); allow write: if darf('spiele.verwalten') || trainerVon(team()); }
    match /sponsoren/{id} { allow read: if sichtbar(); allow write: if darf('sponsoren.verwalten'); }
    match /gegner/{id} { allow read: if sichtbar(); allow write: if darf('spiele.verwalten') || (aktiv() && rolle() == 'trainer'); }
    match /aufrufe/{tag} {
      allow read: if true;
      // anonymer Seitenzähler: nur +1
      allow create: if request.resource.data.keys().hasOnly(['n', 'seiten', 'geraete', 'quellen', 'besuche']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n', 'seiten', 'geraete', 'quellen', 'besuche']) && request.resource.data.n == resource.data.n + 1;
    }
    match /medien/{id} {
      allow read: if true;
      allow create: if aktiv() && request.resource.data.d is string && request.resource.data.d.size() < 1048000;
      allow delete: if darf('medien.verwalten');
    }

    // ---- Teilweise öffentlich ----
    match /news/{id} {
      allow read: if (resource.data.status == 'veroeffentlicht' && sichtbar()) || aktiv();
      allow write: if darf('news.verwalten') || trainerVon(team());
    }
    match /termine/{id} { allow read: if (resource.data.oeffentlich == true && sichtbar()) || aktiv(); allow write: if darf('termine.verwalten'); }
    match /alben/{id} { allow read: if (resource.data.oeffentlich == true && sichtbar()) || aktiv(); allow write: if darf('medien.verwalten') || trainerVon(team()); }
    match /dokumente/{id} {
      allow read: if (resource.data.sichtbar == 'oeffentlich' && sichtbar())
        || (aktiv() && (resource.data.sichtbar == 'mitglieder'
          || (resource.data.sichtbar == 'trainer' && rolle() in ['trainer', 'vorstand', 'admin'])
          || rolle() in ['vorstand', 'admin']));
      allow write: if darf('dokumente.verwalten');
    }
    match /gaestebuch/{id} {
      allow read: if (resource.data.status == 'freigegeben' && sichtbar()) || darf('news.verwalten');
      allow create: if request.resource.data.status == 'neu' && request.resource.data.text is string && request.resource.data.text.size() <= 1500
        && request.resource.data.name.size() <= 60 && !request.resource.data.keys().hasAny(['antwort']);
      allow update, delete: if darf('news.verwalten');
    }

    // ---- Formulare: Gäste dürfen einreichen, lesen nur die Verwaltung ----
    match /antraege/{id} {
      // neue Anträge ohne Bankdaten (die liegen in /bankdaten)
      allow create: if request.resource.data.status == 'neu' && !request.resource.data.keys().hasAny(['iban', 'kontoinhaber']);
      allow read, update, delete: if darf('formulare.verwalten');
    }
    // SEPA-Bankverbindungen: Gäste legen sie mit dem Antrag an, lesen/ändern nur mit dem Recht „Finanzen“ (Kassenwart)
    match /bankdaten/{id} {
      allow create: if request.resource.data.keys().hasOnly(['id', 'antragId', 'kontoinhaber', 'iban', 'datum', 'mandat'])
        && request.resource.data.iban is string && request.resource.data.iban.matches('^[A-Z]{2}[0-9]{2}[A-Z0-9]{10,30}$')
        && request.resource.data.kontoinhaber is string && request.resource.data.kontoinhaber.size() <= 100
        && request.resource.data.mandat == true && id == 'bk-' + request.resource.data.antragId;
      allow read, update, delete: if darf('finanzen.verwalten');
    }
    match /anfragen/{id} {
      allow create: if request.resource.data.status == 'neu' && request.resource.data.nachricht.size() <= 5000;
      allow read, update, delete: if darf('formulare.verwalten');
    }

    // ---- Intern ----
    match /mitteilungen/{id} {
      allow read: if aktiv();
      allow create, delete: if darf('mitteilungen.senden');
      allow update: if darf('mitteilungen.senden') || (aktiv() && nurFelder(['gelesenVon']));
    }
    match /trainings/{id} { allow read: if aktiv(); allow write: if darf('mannschaften.verwalten') || trainerVon(team()); }
    match /mitglieder/{id} { allow read, write: if darf('mitglieder.verwalten'); }
    match /protokoll/{id} { allow create: if aktiv(); allow read, delete: if darf('statistik.sehen'); }

    // ---- Finanzen und E-Mail ----
    match /buchungen/{id} { allow read, write: if darf('finanzen.verwalten'); }
    match /finanzbelege/{id} { allow read, write: if darf('finanzen.verwalten'); }
    match /postausgang/{id} { allow read, write: if darf('email.senden') || darf('finanzen.verwalten') || darf('shop.verwalten'); }

    // ---- Organisation: Aufgaben (Verwaltung oder die zuständige Person) und Verträge ----
    match /aufgaben/{id} {
      allow read: if darf('aufgaben.verwalten') || (aktiv() && resource.data.zustaendigId == request.auth.uid);
      allow create, delete: if darf('aufgaben.verwalten');
      allow update: if darf('aufgaben.verwalten')
        || (aktiv() && resource.data.zustaendigId == request.auth.uid && nurFelder(['erledigt', 'erledigtAm']));
    }
    match /vertraege/{id} { allow read, write: if darf('vertraege.verwalten'); }

    // ---- Fanshop: Artikel öffentlich, Bestellungen dürfen Gäste nur anlegen ----
    match /artikel/{id} { allow read: if sichtbar(); allow write: if darf('shop.verwalten'); }
    match /bestellungen/{id} {
      allow create: if request.resource.data.status == 'neu'
        && request.resource.data.zustimmung.agb == true && request.resource.data.zustimmung.datenschutz == true
        && request.resource.data.bestaetigung in ['offen', 'manuell']
        && request.resource.data.positionen is list && request.resource.data.positionen.size() > 0 && request.resource.data.positionen.size() <= 30
        && request.resource.data.kunde.email is string && request.resource.data.kunde.email.size() <= 120
        && request.resource.data.kunde.name is string && request.resource.data.kunde.name.size() <= 80
        && request.resource.data.versandkosten is number && request.resource.data.versandkosten >= 0
        && !request.resource.data.keys().hasAny(['rechnungId', 'bezahltAm']);
      allow read, update, delete: if darf('shop.verwalten');
    }
  }
}
